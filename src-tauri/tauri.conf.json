{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "luzumi",
  "version": "0.2.0",
  "identifier": "com.luzumi.filemanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luzumi",
        "width": 1100,
        "height": 700,
        "minWidth": 700,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": ["icons/archive.png"]
  }
}
